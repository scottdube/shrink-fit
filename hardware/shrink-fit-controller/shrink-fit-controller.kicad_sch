	)
	(text "GND IS DC-. The controller floats with the bus (SR-11 bond withdrawn). No USB while energised; no earthed scope ground clip - differential probe only."
		(exclude_from_sim no)
		(at 160.02 40.64 0)
		(effects
			(font
