		(title "Shrink-Fit Induction Controller")
		(date "2026-08-31")
		(rev "B")
		(comment 1 "U1 = NodeMCU-32S. Wired by pin NAME; numbers are header positions and pin 26 is named P32. Symbol and footprint are the proven pair from sln-geo-aux-heat.")
